# ==========================================================
# FROC ROTA TURISMO — Variáveis de Ambiente (Vercel & Local)
# Nunca salve chaves reais neste arquivo. Configure-as no painel da Vercel.
# ==========================================================

# 1. Firebase Admin SDK (JSON completo da conta de serviço do projeto gen-lang-client-0017976966)
FIREBASE_SERVICE_ACCOUNT_KEY=

# 2. Mercado Pago (Obrigatórias para pagamentos reais e webhook assinado)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
VITE_MERCADOPAGO_PUBLIC_KEY=

# Mercado Pago Split (OBRIGATÓRIO: toda reserva usa o split; o parceiro conecta a conta dele)
# Pegue em Suas integrações > sua aplicação > Credenciais de produção (Client ID e Client Secret)
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# 3. URL pública da aplicação e Segurança OAuth
APP_URL="https://froc-rota-turismo.vercel.app"
# Opcional: sem ela o servidor usa um segredo estável derivado das outras chaves
OAUTH_STATE_SECRET=

# 3b. Rotinas automáticas diárias (jornal + agentes). A Vercel envia este segredo ao chamar /api/cron.
# Use um texto aleatório com 16+ caracteres.
CRON_SECRET=

# 4. Inteligência Artificial (Gemini API — Froc Rota AI, Jornal Diário & Sistema Anti-Quedas)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_API_KEY_BACKUP=
GEMINI_FALLBACK_MODELS=

# 5. Google Maps Platform (Mapa Interativo no Navegador)
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# 6. Firebase Web SDK / Banco Nomeado (Opcional na Vercel — padrão vem de firebase-applet-config.json)
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# 7. Integrações Opcionais de Viagens & E-mail (Server-Side)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
DUFFEL_ACCESS_TOKEN=
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
TRIVAGO_PARTNER_ID=
RESEND_API_KEY=
