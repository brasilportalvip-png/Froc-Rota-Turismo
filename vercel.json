{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=()"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/api/((?!foto).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, private"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "firebase-applet-config.json",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/plans",
      "destination": "/api/plans"
    },
    {
      "source": "/api/popups",
      "destination": "/api/popups"
    },
    {
      "source": "/api/webhooks/mercadopago",
      "destination": "/api/webhooks/mercadopago"
    },
    {
      "source": "/api/cron",
      "destination": "/api/cron"
    },
    {
      "source": "/api/cron/(.*)",
      "destination": "/api/cron?job=$1"
    },
    {
      "source": "/api/bookings",
      "destination": "/api/bookings?route=/bookings"
    },
    {
      "source": "/api/bookings/(.*)",
      "destination": "/api/bookings?route=/bookings/$1"
    },
    {
      "source": "/api/intent/(.*)",
      "destination": "/api/catalog?route=/intent/$1"
    },
    {
      "source": "/api/fotos/(.*)",
      "destination": "/api/catalog?route=/fotos/$1"
    },
    {
      "source": "/api/passeios",
      "destination": "/api/catalog?route=/passeios"
    },
    {
      "source": "/api/foto",
      "destination": "/api/catalog?route=/foto"
    },
    {
      "source": "/api/brasil/(.*)",
      "destination": "/api/catalog?route=/brasil/$1"
    },
    {
      "source": "/api/destinations",
      "destination": "/api/catalog?route=/destinations"
    },
    {
      "source": "/api/destinations/(.*)",
      "destination": "/api/catalog?route=/destinations/$1"
    },
    {
      "source": "/api/listings",
      "destination": "/api/catalog?route=/listings"
    },
    {
      "source": "/api/listings/(.*)",
      "destination": "/api/catalog?route=/listings/$1"
    },
    {
      "source": "/api/posts",
      "destination": "/api/catalog?route=/posts"
    },
    {
      "source": "/api/pricing/preview",
      "destination": "/api/catalog?route=/pricing/preview"
    },
    {
      "source": "/api/travel/status",
      "destination": "/api/catalog?route=/travel/status"
    },
    {
      "source": "/api/travel/calendar",
      "destination": "/api/catalog?route=/travel/calendar"
    },
    {
      "source": "/api/travel/search",
      "destination": "/api/catalog?route=/travel/search"
    },
    {
      "source": "/api/ai/chat",
      "destination": "/api/catalog?route=/ai/chat"
    },
    {
      "source": "/api/me",
      "destination": "/api/tourist?route=/me"
    },
    {
      "source": "/api/identity/(.*)",
      "destination": "/api/tourist?route=/identity/$1"
    },
    {
      "source": "/api/tourist/(.*)",
      "destination": "/api/tourist?route=/tourist/$1"
    },
    {
      "source": "/api/favorites/toggle",
      "destination": "/api/tourist?route=/favorites/toggle"
    },
    {
      "source": "/api/reviews",
      "destination": "/api/tourist?route=/reviews"
    },
    {
      "source": "/api/concierge",
      "destination": "/api/tourist?route=/concierge"
    },
    {
      "source": "/api/reports",
      "destination": "/api/tourist?route=/reports"
    },
    {
      "source": "/api/travel/orders",
      "destination": "/api/tourist?route=/travel/orders"
    },
    {
      "source": "/api/chat/(.*)",
      "destination": "/api/tourist?route=/chat/$1"
    },
    {
      "source": "/api/merchant/(.*)",
      "destination": "/api/merchant?route=/merchant/$1"
    },
    {
      "source": "/api/oauth/(.*)",
      "destination": "/api/merchant?route=/oauth/$1"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "/api/admin?route=/admin/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?route=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/seo?route=robots"
    },
    {
      "source": "/indexnow-key.txt",
      "destination": "/api/seo?route=indexnow-key"
    },
    {
      "source": "/:file(google[a-zA-Z0-9]+\\.html)",
      "destination": "/api/seo?route=google-verify&f=:file"
    },
    {
      "source": "/destinos",
      "destination": "/api/seo?route=destinos"
    },
    {
      "source": "/destinos/:slug",
      "destination": "/api/seo?route=destino&slug=:slug"
    },
    {
      "source": "/blog",
      "destination": "/api/seo?route=blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/seo?route=post&slug=:slug"
    },
    {
      "source": "/ofertas/:slug",
      "destination": "/api/seo?route=oferta&slug=:slug"
    },
    {
      "source": "/anuncie",
      "destination": "/api/seo?route=anuncie"
    },
    {
      "source": "/sobre",
      "destination": "/api/seo?route=sobre"
    },
    {
      "source": "/contato",
      "destination": "/api/seo?route=contato"
    },
    {
      "source": "/politica-de-privacidade",
      "destination": "/api/seo?route=privacidade"
    },
    {
      "source": "/termos-de-uso",
      "destination": "/api/seo?route=termos"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/jornal",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/agentes",
      "schedule": "30 10 * * *"
    }
  ]
}
