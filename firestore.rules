rules_version = '2';

// Froc Rota Turismo — o navegador NÃO lê nem grava o banco diretamente.
// Todo acesso passa pelas funções do servidor (/api/*), que usam o Firebase Admin e conferem
// login, dono do dado e permissões. Por isso o banco fica 100% fechado para acesso direto:
// ninguém consegue listar CPF, telefone, reservas ou conversas usando a chave pública do app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
